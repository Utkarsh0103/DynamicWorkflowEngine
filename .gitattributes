*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.pyc binary
*.pdf binary

# Markdown
*.md text diff=markdown

# Documentation
*.markdown text diff=markdown
*.mdown text diff=markdown
